[Unit]
Description=Reload drbd-reactor on plugin changes
After=drbd-reactor.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Reloads a running drbd-reactor and does nothing while it is stopped.
# This should be "try-reload-or-restart", but that name only exists since
# systemd 229. XCP-ng (CentOS 7 based dom0, systemd 219) only knows the
# legacy spelling, which is the same operation.
ExecStart=/usr/bin/systemctl reload-or-try-restart drbd-reactor.service

[Install]
WantedBy=multi-user.target

